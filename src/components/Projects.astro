---
import { projects } from '../data/projects';
import { projectsSection } from '../data/site';
---

<section id="projects" class="scroll-mt-20">
	<div class="mx-auto max-w-6xl px-6 py-24">
		<h2 class="mb-12 text-3xl font-bold tracking-tight md:text-4xl">{projectsSection.title}</h2>
		<div class="grid gap-6 md:grid-cols-2">
			{projects.map((project) => (
				<article class="flex flex-col rounded-2xl border border-neutral-200 bg-white overflow-hidden transition hover:-translate-y-1 hover:shadow-lg">
					<div class="aspect-video border-b border-neutral-200 bg-neutral-100">
						{project.image && (
							<img src={project.image} alt={project.title} loading="lazy" decoding="async" class="size-full object-cover" />
						)}
					</div>
					<div class="flex flex-1 flex-col p-6">
						<div class="flex items-baseline justify-between gap-4">
							<h3 class="text-xl font-bold">{project.title}</h3>
							{project.year && <span class="text-sm text-neutral-500">{project.year}</span>}
						</div>
						{project.subtitle && <p class="text-sm font-medium text-neutral-500">{project.subtitle}</p>}
						<p class="mt-3 text-neutral-600">{project.description}</p>
						<ul class="mt-4 flex flex-wrap gap-2">
							{project.tags.map((tag) => (
								<li class="rounded-full bg-neutral-100 px-3 py-1 text-xs font-medium text-neutral-700">{tag}</li>
							))}
						</ul>
						{(project.demo || project.repo) && (
							<div class="mt-auto flex gap-5 pt-6 text-sm font-medium">
								{project.demo && (
									<a href={project.demo} target="_blank" rel="noopener noreferrer" class="text-neutral-900 underline-offset-4 hover:underline">
										Live Demo ↗
									</a>
								)}
								{project.repo && (
									<a href={project.repo} target="_blank" rel="noopener noreferrer" class="text-neutral-500 underline-offset-4 hover:text-neutral-900 hover:underline">
										Source Code ↗
									</a>
								)}
							</div>
						)}
					</div>
				</article>
			))}
		</div>
	</div>
</section>
