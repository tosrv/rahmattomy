---
import { about } from '../data/site';
---

<section id="about" class="scroll-mt-20 border-t border-neutral-200">
	<div class="mx-auto grid max-w-6xl gap-12 px-6 py-24 md:grid-cols-[1fr_2fr]">
		<h2 class="text-3xl font-bold tracking-tight md:text-4xl">{about.title}</h2>
		<div class="space-y-6 text-lg text-neutral-700">
			{about.paragraphs.map((p) => <p>{p}</p>)}
			<ul class="flex flex-wrap gap-2 pt-2">
				{about.skills.map((skill) => (
					<li class="rounded-full border border-neutral-300 px-4 py-1.5 text-sm font-medium">{skill}</li>
				))}
			</ul>
		</div>
	</div>
</section>
