---
import { contact, profile } from '../data/site';
---

<section id="contact" class="scroll-mt-20 border-t border-neutral-200">
	<div class="mx-auto max-w-6xl px-6 py-24 text-center">
		<h2 class="text-4xl font-bold tracking-tight md:text-6xl">{contact.title}</h2>
		<p class="mx-auto mt-4 max-w-lg text-lg text-neutral-600">
			{contact.description}
		</p>
		<a
			href={`mailto:${profile.email}`}
			class="mt-10 inline-block rounded-full bg-neutral-900 px-6 py-3 font-medium text-white transition hover:bg-neutral-700"
		>
			{profile.email}
		</a>
	</div>
</section>
