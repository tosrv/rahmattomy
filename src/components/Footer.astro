---
import { footer, socials } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="border-t border-neutral-200">
	<div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-4 px-6 py-8 text-sm text-neutral-500 md:flex-row">
		<p>&copy; {year} {footer.copyright}</p>
		<ul class="flex gap-6">
			{socials.map((s) => (
				<li><a href={s.href} target="_blank" rel="noopener noreferrer" class="hover:text-neutral-900">{s.label}</a></li>
			))}
		</ul>
	</div>
</footer>
