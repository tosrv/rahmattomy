---
import { experience } from '../data/experience';
---

<section id="work" class="scroll-mt-20">
	<div class="mx-auto max-w-6xl px-6 py-24">
		<h2 class="mb-12 text-3xl font-bold tracking-tight md:text-4xl">Work Experience</h2>
		<ol class="space-y-12">
			{experience.map((job) => (
				<li class="grid gap-4 md:grid-cols-[1fr_3fr] md:gap-12">
					<div class="text-sm text-neutral-500">
						<p class="font-medium text-neutral-700">{job.period}</p>
						<p class="mt-1">{job.location}</p>
					</div>
					<div>
						<div class="flex flex-wrap items-center gap-x-3 gap-y-2">
							<h3 class="text-xl font-bold">{job.company}</h3>
							{job.current && (
								<span class="rounded-full bg-neutral-900 px-2.5 py-0.5 text-xs font-medium text-white">Current</span>
							)}
						</div>
						<p class="mt-1 text-neutral-600">{job.role}</p>
						<ul class="mt-4 list-disc space-y-2 pl-5 text-neutral-600 marker:text-neutral-400">
							{job.highlights.map((item) => <li>{item}</li>)}
						</ul>
						{job.tags && (
							<ul class="mt-4 flex flex-wrap gap-2">
								{job.tags.map((tag) => (
									<li class="rounded-full bg-neutral-100 px-3 py-1 text-xs font-medium text-neutral-700">{tag}</li>
								))}
							</ul>
						)}
					</div>
				</li>
			))}
		</ol>
	</div>
</section>
